{
  "mcpServers": {
    "cvapp": {
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "--manifest-path",
        "crates/cvapp-cli/Cargo.toml",
        "--bin",
        "cvapp",
        "--",
        "mcp"
      ],
      "env": {
        "RUST_BACKTRACE": "1"
      }
    }
  }
}
